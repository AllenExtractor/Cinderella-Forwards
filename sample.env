# Cinderella-Forwards Bot — Environment Variables
# Copy this to .env and fill in your values

# ── Required ──────────────────────────────────────────────────────────────────
BOT_TOKEN=your_bot_token_here
API_ID=your_api_id_here
API_HASH=your_api_hash_here
OWNER=your_telegram_user_id

# ── Optional ──────────────────────────────────────────────────────────────────
CREDIT=💥 @YourContactBot
AUTH_USERS=123456789,987654321

# ── Userbot (for private/restricted source channels) ─────────────────────────
# Generate via: python3 generate_session.py
SESSION_STRING=

# ── Forward delay in seconds (default: 3) ────────────────────────────────────
FORWARD_DELAY=3
